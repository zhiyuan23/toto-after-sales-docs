#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "$0")" && pwd)"
documentation_root="$(cd "$hook_dir/.." && pwd)"
repository_root="$(git rev-parse --show-toplevel)"

# Git exports repository-local variables to hooks. Clear them before the Node
# script invokes `git -C` for other repositories, otherwise the originating
# repository's index/object paths leak into those commands.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX

node "$documentation_root/scripts/check-doc-impact.mjs" \
    --staged \
    --repo "$repository_root"
